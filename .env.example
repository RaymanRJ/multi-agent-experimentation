# Copy to .env — never commit the result.
# The local (Ollama) brain needs no key; cloud brains stay dormant without these.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Other OpenAI-compatible providers: set a key AND a model to use one (--brain grok, etc.).
# Each model also needs its price in src/backends/pricing.ts, or a paid run refuses to start.
XAI_API_KEY=
XAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_CONTEXT=8192

MC_HOST=localhost
MC_PORT=25565
RCON_PORT=25575
RCON_PASSWORD=devpassword
