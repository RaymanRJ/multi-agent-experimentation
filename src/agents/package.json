{
  "name": "multi-agent-experimentation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Several AI agents in one shared world, each driven by a different model.",
  "scripts": {
    "agent": "tsx src/agent.ts",
    "minds": "tsx src/minds.ts",
    "typecheck": "tsc --noEmit",
    "try": "tsx src/try.ts",
    "report": "tsx src/report.ts",
    "summary": "tsx src/summary.ts",
    "compare": "tsx src/compare.ts",
    "skills": "tsx src/skillsReport.ts",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "canvas": "^3.2.3",
    "mineflayer": "^4.23.0",
    "mineflayer-pathfinder": "^2.4.5",
    "minimist": "^1.2.8",
    "prismarine-viewer": "^1.33.0",
    "rcon-client": "^4.2.4"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
