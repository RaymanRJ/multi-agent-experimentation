# Copy to backend.hcl (gitignored) and fill in, then: terraform init -backend-config=backend.hcl
# The bucket must already exist; it can hold state for many projects under different keys.
bucket       = "my-terraform-state"
key          = "multi-agent-experimentation/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true
